{
  "schema_version": 1,
  "name": "실기기: 사진 왕복 (좌표 보정 후 1회 실행)",
  "app_profile": "photos",
  "device_profile": "my_iphone_portrait",
  "on_failure": "stop",
  "setup": [
    {
      "type": "activate_app"
    },
    {
      "type": "tap",
      "target": {
        "mode": "normalized",
        "x": 0.25,
        "y": 0.35
      },
      "after_delay_ms": 1000
    }
  ],
  "steps": [
    {
      "type": "repeat",
      "count": 1,
      "between_iterations_ms": 500,
      "steps": [
        {
          "type": "swipe",
          "from": {
            "x": 0.8,
            "y": 0.5
          },
          "to": {
            "x": 0.2,
            "y": 0.5
          },
          "move_duration_ms": 300,
          "after_delay_ms": 1000
        },
        {
          "type": "swipe",
          "from": {
            "x": 0.2,
            "y": 0.5
          },
          "to": {
            "x": 0.8,
            "y": 0.5
          },
          "move_duration_ms": 300,
          "after_delay_ms": 1000
        }
      ]
    }
  ]
}
