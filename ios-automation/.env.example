# cp .env.example .env 후 실제 값을 입력하세요.
# Xcode > Window > Devices and Simulators에서 확인한 아이폰 Identifier
IOS_UDID=

# WDA 서명에 사용할 Apple 개발 Team ID (영문 대문자/숫자 10자리)
IOS_TEAM_ID=

# 해당 Team에서 프로비저닝한 WDA Bundle Identifier (.xctrunner 제외)
WDA_BUNDLE_ID=

# 선택: PhotosExportBridge 앱의 본인 Bundle ID. 입력하면 JPEG 저장 후 원본 복원 모드.
# 비워 두면 사진 저장 없이 프리뷰/결과 화면 캡처 후 취소하는 모드.
IOS_EXPORT_BUNDLE_ID=
